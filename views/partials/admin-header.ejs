<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Quản trị ReviewBooks</title>
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/admin.js" defer></script>
  <script src="/js/main.js" defer></script>
</head>
<body>
<header class="site-header">
  <div class="navbar">
    <a class="brand" href="/admin/dashboard">
      <span class="brand-mark">RB</span>
      <span>Quản trị ReviewBooks</span>
    </a>
    <button class="nav-toggle" type="button" data-nav-toggle aria-label="Mở menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <div class="nav-panel" data-nav-panel>
      <div class="nav-auth">
        <a class="btn btn-outline btn-sm" href="/">Xem trang người dùng</a>
        <form action="/logout" method="POST">
          <button class="btn btn-outline btn-sm" type="submit">Đăng xuất</button>
        </form>
      </div>
    </div>
  </div>
</header>
<main>
  <div class="container admin-layout">
    <aside class="admin-sidebar">
      <ul>
        <li><a class="<%= currentPath === '/admin/dashboard' ? 'is-active' : '' %>" href="/admin/dashboard">Tổng quan</a></li>
        <li><a class="<%= currentPath.startsWith('/admin/books') ? 'is-active' : '' %>" href="/admin/books">Sách</a></li>
        <li><a class="<%= currentPath.startsWith('/admin/authors') ? 'is-active' : '' %>" href="/admin/authors">Tác giả</a></li>
        <li><a class="<%= currentPath.startsWith('/admin/categories') ? 'is-active' : '' %>" href="/admin/categories">Thể loại</a></li>
        <li><a class="<%= currentPath.startsWith('/admin/users') ? 'is-active' : '' %>" href="/admin/users">Người dùng</a></li>
        <li><a class="<%= currentPath.startsWith('/admin/comments') ? 'is-active' : '' %>" href="/admin/comments">Bình luận</a></li>
        <li><a class="<%= currentPath.startsWith('/admin/contacts') ? 'is-active' : '' %>" href="/admin/contacts">Liên hệ</a></li>
      </ul>
    </aside>
    <div>
      <%- include('flash') %>
