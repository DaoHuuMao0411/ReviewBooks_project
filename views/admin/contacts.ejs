<%- include('../partials/admin-header') %>

<h1>Liên hệ</h1>

<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr><th>Họ tên</th><th>Email</th><th>Tiêu đề</th><th>Nội dung</th><th>Ngày</th></tr>
    </thead>
    <tbody
      data-infinite-scroll
      data-url="/admin/contacts"
      data-params="<%= filterQuery %>"
      data-next-page="<%= pagination.currentPage + 1 %>"
      data-has-more="<%= pagination.hasNext %>"
      data-total="<%= pagination.totalItems %>"
      data-colspan="5"
    >
      <%- include('partials/contact-rows', { contacts }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/admin-footer') %>
